local Players = game:GetService("Players")

local player = Players.LocalPlayer
if not player then
    return {
        Init = function() end,
        Enable = function() end,
        Disable = function() end,
        Toggle = function() end,
        SetGravity = function() end,
        GetGravity = function() return workspace.Gravity end,
        IsEnabled = function() return false end,
    }
end

local M = {
    enabled = false,
    conns = {},
    charConn = nil,
    -- 当前自定义重力值
    currentGravity = workspace.Gravity,
    -- 初始全局重力（只在启用前记录一次）
    originalGravity = nil,
    originalRecorded = false,
}

local function safeDisconnect(c)
    if c and typeof(c) == "RBXScriptConnection" then
        pcall(function() c:Disconnect() end)
    end
end

local function applyGravity(value)
    local n = tonumber(value)
    if not n then return false, "invalid number" end
    local ok, err = pcall(function() workspace.Gravity = n end)
    return ok, err
end

local function reapplyEnabledFeatures()
    if M.enabled then
        applyGravity(M.currentGravity)
    else
        if M.originalRecorded and M.originalGravity ~= nil then
            pcall(function() workspace.Gravity = M.originalGravity end)
        end
    end
end

local function onCharacterAdded()
    -- 角色重生时确保如果正在启用，则重新应用自定义重力
    reapplyEnabledFeatures()
end

function M.Init()
    if M.charConn then return end
    M.currentGravity = M.currentGravity or workspace.Gravity
    M.charConn = player.CharacterAdded:Connect(onCharacterAdded)
    table.insert(M.conns, M.charConn)
    -- 不自动改变重力（仅在 Enable 时生效）
end

function M.Enable()
    if M.enabled then return end
    -- 记录原始重力（仅首次启用时）
    if not M.originalRecorded then
        M.originalGravity = workspace.Gravity
        M.originalRecorded = true
    end
    M.enabled = true
    applyGravity(M.currentGravity)
end

function M.Disable()
    if not M.enabled then return end
    M.enabled = false
    -- 恢复为启用前记录的原始重力（如果有记录）
    if M.originalRecorded and M.originalGravity ~= nil then
        pcall(function() workspace.Gravity = M.originalGravity end)
        -- 恢复后清除记录，这样下一次启用会重新记录“启用前”的值
        M.originalGravity = nil
        M.originalRecorded = false
    end
end

function M.Toggle(state)
    if state == nil then
        if M.enabled then M.Disable() else M.Enable() end
    elseif state then
        M.Enable()
    else
        M.Disable()
    end
end

function M.SetGravity(n)
    local num = tonumber(n)
    if not num then return false end
    M.currentGravity = num
    if M.enabled then
        return applyGravity(num)
    end
    return true
end

function M.GetGravity()
    return M.currentGravity
end

function M.IsEnabled()
    return M.enabled
end

pcall(function() M.Init() end)

return M
