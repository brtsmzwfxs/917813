-- CharacterStats.module.lua
-- Remote module for the Character Stats UI
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local GuiService = game:GetService("GuiService")
local CoreGui = game:GetService("CoreGui")
local Debris = game:GetService("Debris")

local localPlayer = Players.LocalPlayer

local M = {
    initialized = false,
    enabled = false,
    -- UI references
    screenGui = nil,
    frame = nil,
    switchScreenGui = nil,
    toggleButton = nil,
    healthBarGui = nil,
    -- dynamic state
    lastPosition = nil,
    currentSpeed = 0,
    lastHealth = 100,
    damageNumbers = {},
    statsVisible = true,
    damageAccumulator = 0,
    healAccumulator = 0,
    lastDisplayTime = 0,
    -- connections
    conns = {},
    heartbeatConn = nil,
}

-- config / helpers
local function formatNumber(value)
    local truncated = math.floor(value * 10) / 10
    if truncated == math.floor(truncated) then
        return tostring(math.floor(truncated))
    else
        return string.format("%.1f", truncated)
    end
end

local function safeDisconnect(conn)
    if conn and typeof(conn) == "RBXScriptConnection" then
        pcall(function() conn:Disconnect() end)
    end
end

-- create UI elements (but do not start logic until Enable)
local function createBaseUI()
    if not localPlayer then return end

    -- PlayerGui main screen
    local playerGui = localPlayer:WaitForChild("PlayerGui")

    local screenGui = Instance.new("ScreenGui")
    screenGui.Name = "CharacterStatsGui"
    screenGui.Parent = playerGui
    screenGui.ResetOnSpawn = false
    screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(0, 180, 0, 120)
    frame.Position = UDim2.new(0, 10, 1, -130)
    frame.BackgroundTransparency = 1
    frame.BorderSizePixel = 0
    frame.Parent = screenGui

    -- switch button in CoreGui (appears when menu opens)
    local switchScreenGui = Instance.new("ScreenGui")
    switchScreenGui.Name = "StatsSwitchGui"
    switchScreenGui.Parent = CoreGui
    switchScreenGui.ResetOnSpawn = false
    switchScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    switchScreenGui.DisplayOrder = 10

    local toggleButton = Instance.new("TextButton")
    toggleButton.Size = UDim2.new(0, 100, 0, 40)
    toggleButton.Position = UDim2.new(0.5, -450, 0.5, -190)
    toggleButton.AnchorPoint = Vector2.new(0.5, 0.5)
    toggleButton.BackgroundColor3 = Color3.fromRGB(0, 120, 255)
    toggleButton.Text = "隐藏数值"
    toggleButton.TextColor3 = Color3.fromRGB(255, 255, 255)
    toggleButton.Font = Enum.Font.GothamBold
    toggleButton.TextSize = 16
    toggleButton.TextStrokeTransparency = 0
    toggleButton.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    toggleButton.BorderSizePixel = 0
    toggleButton.ZIndex = 100
    toggleButton.Visible = false
    toggleButton.Parent = switchScreenGui

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 8)
    corner.Parent = toggleButton

    -- labels creator
    local function createTextLabel(parent, text, pos)
        local lbl = Instance.new("TextLabel")
        lbl.Size = UDim2.new(1, 0, 0, 20)
        lbl.Position = pos
        lbl.BackgroundTransparency = 1
        lbl.TextColor3 = Color3.fromRGB(255, 255, 255)
        lbl.Text = text
        lbl.Font = Enum.Font.GothamBold
        lbl.TextSize = 13
        lbl.TextXAlignment = Enum.TextXAlignment.Left
        lbl.TextStrokeTransparency = 0
        lbl.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
        lbl.ZIndex = 2
        lbl.Parent = parent
        return lbl
    end

    local speedLabel = createTextLabel(frame, "移动速度: 0", UDim2.new(0, 0, 0, 0))
    local walkSpeedLabel = createTextLabel(frame, "行走速度: 0", UDim2.new(0, 0, 0, 25))
    local jumpLabel = createTextLabel(frame, "跳跃力量: 0", UDim2.new(0, 0, 0, 50))
    local gravityLabel = createTextLabel(frame, "重力: " .. formatNumber(workspace.Gravity), UDim2.new(0, 0, 0, 75))

    -- store in module
    M.screenGui = screenGui
    M.frame = frame
    M.switchScreenGui = switchScreenGui
    M.toggleButton = toggleButton
    M.speedLabel = speedLabel
    M.walkSpeedLabel = walkSpeedLabel
    M.jumpLabel = jumpLabel
    M.gravityLabel = gravityLabel
end

local function createHealthBar(character)
    if not character then return nil end
    if M.healthBarGui and M.healthBarGui.Parent then
        M.healthBarGui:Destroy()
        M.healthBarGui = nil
    end

    local humanoidRootPart = character:WaitForChild("HumanoidRootPart", 5)
    if not humanoidRootPart then return nil end

    local healthBarGui = Instance.new("BillboardGui")
    healthBarGui.Name = "HealthBar"
    healthBarGui.Size = UDim2.new(3, 0, 0.4, 0)
    healthBarGui.StudsOffset = Vector3.new(0, -2.5, 0)
    healthBarGui.AlwaysOnTop = true
    healthBarGui.Adornee = humanoidRootPart
    healthBarGui.Enabled = M.statsVisible
    healthBarGui.Parent = humanoidRootPart

    local healthBarBackground = Instance.new("Frame")
    healthBarBackground.Size = UDim2.new(1, 0, 1, 0)
    healthBarBackground.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
    healthBarBackground.BorderSizePixel = 0
    healthBarBackground.Parent = healthBarGui

    local backgroundCorner = Instance.new("UICorner")
    backgroundCorner.CornerRadius = UDim.new(0.5, 0)
    backgroundCorner.Parent = healthBarBackground

    local healthBar = Instance.new("Frame")
    healthBar.Size = UDim2.new(1, 0, 1, 0)
    healthBar.BackgroundColor3 = Color3.fromRGB(0, 255, 0)
    healthBar.BorderSizePixel = 0
    healthBar.Parent = healthBarBackground

    local healthBarCorner = Instance.new("UICorner")
    healthBarCorner.CornerRadius = UDim.new(0.5, 0)
    healthBarCorner.Parent = healthBar

    local healthText = Instance.new("TextLabel")
    healthText.Size = UDim2.new(1, 0, 1, 0)
    healthText.BackgroundTransparency = 1
    healthText.Text = "100/100"
    healthText.TextColor3 = Color3.fromRGB(255, 255, 255)
    healthText.Font = Enum.Font.GothamBold
    healthText.TextSize = 10
    healthText.TextStrokeTransparency = 0
    healthText.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    healthText.ZIndex = 3
    healthText.Parent = healthBarGui

    M.healthBarGui = healthBarGui
    return healthBar, healthText
end

local function updateHealthBar(humanoid, healthBar, healthText)
    if humanoid and healthBar and healthText then
        local currentHealth = humanoid.Health
        local maxHealth = humanoid.MaxHealth > 0 and humanoid.MaxHealth or 1
        local healthPercentage = math.clamp(currentHealth / maxHealth, 0, 1)
        healthBar.Size = UDim2.new(healthPercentage, 0, 1, 0)
        healthText.Text = formatNumber(currentHealth) .. "/" .. formatNumber(maxHealth)

        if healthPercentage > 0.5 then
            healthBar.BackgroundColor3 = Color3.fromRGB(0, 255, 0)
        elseif healthPercentage > 0.25 then
            healthBar.BackgroundColor3 = Color3.fromRGB(255, 255, 0)
        else
            healthBar.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
        end
    end
end

local function showDamageNumber(character, amount, isHeal)
    if not M.statsVisible then return end
    if not character then return end
    local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
    if not humanoidRootPart then return end

    local startOffset = Vector3.new(0, 3, 0)

    local billboardGui = Instance.new("BillboardGui")
    billboardGui.Size = UDim2.new(4, 0, 2, 0)
    billboardGui.StudsOffset = startOffset
    billboardGui.AlwaysOnTop = true
    billboardGui.Adornee = humanoidRootPart
    billboardGui.Enabled = M.statsVisible
    billboardGui.Parent = humanoidRootPart

    local formattedAmount = formatNumber(math.abs(amount))

    local textLabel = Instance.new("TextLabel")
    textLabel.Size = UDim2.new(1, 0, 1, 0)
    textLabel.BackgroundTransparency = 1
    textLabel.Text = (isHeal and "+" or "-") .. formattedAmount
    textLabel.TextColor3 = isHeal and Color3.fromRGB(0, 255, 0) or Color3.fromRGB(255, 0, 0)
    textLabel.Font = Enum.Font.GothamBold
    textLabel.TextSize = 18
    textLabel.TextStrokeTransparency = 0
    textLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    textLabel.Parent = billboardGui

    -- store metadata for animation
    table.insert(M.damageNumbers, {
        gui = billboardGui,
        startTime = tick(),
        startPosition = startOffset,
        velocity = Vector3.new((math.random() - 0.5) * 2, 3, 0),
        gravity = 8,
        bounceFactor = 0.7,
        minBounceVelocity = 0.1,
        hasBounced = false,
        isHeal = isHeal,
        textLabel = textLabel
    })

    Debris:AddItem(billboardGui, 3)
end

local function updateDamageNumbers(dt)
    local currentTime = tick()
    for i = #M.damageNumbers, 1, -1 do
        local data = M.damageNumbers[i]
        if data.gui and data.gui.Parent then
            local elapsed = currentTime - data.startTime
            if elapsed < 3 then
                -- simple physics-ish update using dt
                data.velocity = Vector3.new(data.velocity.X, data.velocity.Y - data.gravity * dt, 0)
                local newStudsY = data.gui.StudsOffset.Y + data.velocity.Y * dt
                data.gui.StudsOffset = Vector3.new(data.gui.StudsOffset.X, newStudsY, data.gui.StudsOffset.Z)

                local transparency = math.clamp(elapsed / 3, 0, 1)
                if data.textLabel then
                    data.textLabel.TextTransparency = transparency
                    data.textLabel.TextStrokeTransparency = transparency
                end
            else
                if data.gui then
                    pcall(function() data.gui:Destroy() end)
                end
                table.remove(M.damageNumbers, i)
            end
        else
            table.remove(M.damageNumbers, i)
        end
    end
end

local function updateSpeed(dt)
    if not M.statsVisible then return end
    if not localPlayer then return end
    if localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart") then
        local rootPart = localPlayer.Character.HumanoidRootPart
        local currentPosition = rootPart.Position
        if M.lastPosition then
            local distance = (currentPosition - M.lastPosition).Magnitude
            M.currentSpeed = distance / math.max(dt, 1e-6)
            if M.speedLabel then
                M.speedLabel.Text = "移动速度: " .. formatNumber(M.currentSpeed)
            end
        end
        M.lastPosition = currentPosition
    else
        if M.speedLabel then
            M.speedLabel.Text = "移动速度: N/A"
        end
    end
end

local function updateCharacterStats()
    if not M.statsVisible or not localPlayer then return end
    local humanoid = localPlayer.Character and localPlayer.Character:FindFirstChildOfClass("Humanoid")
    if humanoid then
        if M.walkSpeedLabel then
            M.walkSpeedLabel.Text = "行走速度: " .. formatNumber(humanoid.WalkSpeed)
        end
        if M.jumpLabel then
            if humanoid.UseJumpPower then
                M.jumpLabel.Text = "跳跃力量: " .. formatNumber(humanoid.JumpPower)
            else
                M.jumpLabel.Text = "跳跃高度: " .. formatNumber(humanoid.JumpHeight)
            end
        end
    else
        if M.walkSpeedLabel then M.walkSpeedLabel.Text = "行走速度: N/A" end
        if M.jumpLabel then M.jumpLabel.Text = "跳跃力量: N/A" end
    end
end

local function updateGravityLabel()
    if M.gravityLabel then
        M.gravityLabel.Text = "重力: " .. formatNumber(workspace.Gravity)
    end
end

-- health monitoring & setup
local function setupHealthMonitoring(character)
    if not character then return end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end
    local healthBar, healthText = createHealthBar(character)
    if not healthBar then return end
    M.lastHealth = humanoid.Health

    local conn = humanoid.HealthChanged:Connect(function(newHealth)
        updateHealthBar(humanoid, healthBar, healthText)
        local healthDiff = newHealth - M.lastHealth
        if math.abs(healthDiff) > 0.01 then
            if healthDiff > 0 then
                M.healAccumulator = M.healAccumulator + healthDiff
            else
                M.damageAccumulator = M.damageAccumulator + math.abs(healthDiff)
            end
        end
        M.lastHealth = newHealth
    end)
    table.insert(M.conns, conn)
    updateHealthBar(humanoid, healthBar, healthText)
end

-- menu toggle handling
local function toggleStatsVisibility()
    M.statsVisible = not M.statsVisible
    if M.frame then M.frame.Visible = M.statsVisible end
    if M.toggleButton then
        if M.statsVisible then
            M.toggleButton.Text = "隐藏数值"
            M.toggleButton.BackgroundColor3 = Color3.fromRGB(0, 120, 255)
        else
            M.toggleButton.Text = "显示数值"
            M.toggleButton.BackgroundColor3 = Color3.fromRGB(120, 120, 120)
        end
    end
    if M.healthBarGui then M.healthBarGui.Enabled = M.statsVisible end
    for _, data in ipairs(M.damageNumbers) do
        if data.gui and data.gui.Parent then
            data.gui.Enabled = M.statsVisible
        end
    end
end

-- menu opened/closed handlers
local function onMenuOpened()
    if M.toggleButton then M.toggleButton.Visible = true end
end
local function onMenuClosed()
    if M.toggleButton then M.toggleButton.Visible = false end
end

-- heartbeat main update
local lastTick = tick()
local function heartbeat(dt)
    -- dt comes from RunService.Heartbeat; guard
    updateSpeed(dt)
    updateDamageNumbers(dt)

    local now = tick()
    if now - M.lastDisplayTime >= 0.3 then
        M.lastDisplayTime = now
        if M.damageAccumulator > 0 and localPlayer.Character then
            showDamageNumber(localPlayer.Character, M.damageAccumulator, false)
            M.damageAccumulator = 0
        end
        if M.healAccumulator > 0 and localPlayer.Character then
            showDamageNumber(localPlayer.Character, M.healAccumulator, true)
            M.healAccumulator = 0
        end
    end
end

-- public API
function M.Init(autoEnable)
    if M.initialized then return end
    if not localPlayer then return end
    M.initialized = true
    M.lastDisplayTime = tick()
    createBaseUI()

    -- connect toggle button click
    if M.toggleButton then
        table.insert(M.conns, M.toggleButton.MouseButton1Click:Connect(toggleStatsVisibility))
    end

    -- connect menu events
    table.insert(M.conns, GuiService.MenuOpened:Connect(onMenuOpened))
    table.insert(M.conns, GuiService.MenuClosed:Connect(onMenuClosed))

    -- listen workspace gravity changes
    table.insert(M.conns, workspace:GetPropertyChangedSignal("Gravity"):Connect(updateGravityLabel))

    -- character handling
    table.insert(M.conns, Players.LocalPlayer.CharacterAdded:Connect(function(character)
        updateCharacterStats()
        setupHealthMonitoring(character)
        M.damageAccumulator = 0
        M.healAccumulator = 0
        -- property change signals for humanoid
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if humanoid then
            table.insert(M.conns, humanoid:GetPropertyChangedSignal("WalkSpeed"):Connect(updateCharacterStats))
            table.insert(M.conns, humanoid:GetPropertyChangedSignal("JumpPower"):Connect(updateCharacterStats))
            table.insert(M.conns, humanoid:GetPropertyChangedSignal("JumpHeight"):Connect(updateCharacterStats))
            table.insert(M.conns, humanoid:GetPropertyChangedSignal("UseJumpPower"):Connect(updateCharacterStats))
        end
        if character:WaitForChild("HumanoidRootPart", 5) then
            M.lastPosition = character.HumanoidRootPart.Position
        end
    end))

    -- if already in character, set up immediately
    if Players.LocalPlayer.Character then
        updateCharacterStats()
        setupHealthMonitoring(Players.LocalPlayer.Character)
        local hum = Players.LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if hum then
            table.insert(M.conns, hum:GetPropertyChangedSignal("WalkSpeed"):Connect(updateCharacterStats))
            table.insert(M.conns, hum:GetPropertyChangedSignal("JumpPower"):Connect(updateCharacterStats))
            table.insert(M.conns, hum:GetPropertyChangedSignal("JumpHeight"):Connect(updateCharacterStats))
            table.insert(M.conns, hum:GetPropertyChangedSignal("UseJumpPower"):Connect(updateCharacterStats))
        end
        if Players.LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
            M.lastPosition = Players.LocalPlayer.Character.HumanoidRootPart.Position
        end
    end

    -- create heartbeat connection (inactive until Enable)
    M.heartbeatConn = RunService.Heartbeat:Connect(function(dt)
        if M.enabled then
            heartbeat(dt)
        end
    end)

    if autoEnable then
        M.Enable()
    end
end

function M.Enable()
    if not M.initialized then M.Init(true); return end
    if M.enabled then return end
    M.enabled = true
    -- ensure GUIs are visible
    if M.frame then M.frame.Visible = M.statsVisible end
    if M.toggleButton then M.toggleButton.Visible = false end -- visible only when menu opens
    updateGravityLabel()
    updateCharacterStats()
end

function M.Disable()
    if not M.initialized then return end
    if not M.enabled then return end
    M.enabled = false
    if M.frame then M.frame.Visible = false end
    if M.healthBarGui then M.healthBarGui.Enabled = false end
    for _, data in ipairs(M.damageNumbers) do
        if data.gui then
            data.gui.Enabled = false
        end
    end
end

function M.Toggle(state)
    if state == nil then
        if M.enabled then M.Disable() else M.Enable() end
    elseif state then
        M.Enable()
    else
        M.Disable()
    end
end

function M.IsEnabled()
    return M.enabled
end

function M.Cleanup()
    -- fully disconnect & destroy
    M.Disable()
    for _, c in ipairs(M.conns) do
        safeDisconnect(c)
    end
    M.conns = {}
    if M.heartbeatConn then safeDisconnect(M.heartbeatConn); M.heartbeatConn = nil end
    if M.screenGui then
        pcall(function() M.screenGui:Destroy() end)
        M.screenGui = nil
    end
    if M.switchScreenGui then
        pcall(function() M.switchScreenGui:Destroy() end)
        M.switchScreenGui = nil
    end
    if M.healthBarGui then
        pcall(function() M.healthBarGui:Destroy() end)
        M.healthBarGui = nil
    end
    for _, data in ipairs(M.damageNumbers) do
        if data.gui then pcall(function() data.gui:Destroy() end) end
    end
    M.damageNumbers = {}
    M.initialized = false
    M.enabled = false
end

return M
