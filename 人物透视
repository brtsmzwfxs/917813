-- Utilities for config encode/decode (match original behavior for Color3/UDim2)
local function deepsearchset(tbl, ret, value)
    if type(tbl) ~= "table" then return tbl end
    local new = {}
    for i, v in next, tbl do
        new[i] = v
        if type(v) == "table" then
            new[i] = deepsearchset(v, ret, value)
        end
        if ret(i, v) then
            new[i] = value(i, v)
        end
    end
    return new
end

local function DecodeConfig(Config)
    local DecodedConfig = deepsearchset(Config, function(Index, Value)
        return type(Value) == "table" and (Value.HSVColor or Value.Position)
    end, function(Index, Value)
        local Color = Value.HSVColor
        local Position = Value.Position
        if (Color) then
            return Color3.fromHSV(Color.H, Color.S, Color.V)
        end
        if (Position and Position.Y and Position.X) then
            return UDim2.new(UDim.new(Position.X.Scale, Position.X.Offset), UDim.new(Position.Y.Scale, Position.Y.Offset))
        else
            return DefaultSettings.WindowPosition
        end
    end)
    return DecodedConfig
end

local function EncodeConfig(Config)
    local ToHSV = Color3.new().ToHSV
    local EncodedConfig = deepsearchset(Config, function(Index, Value)
        return typeof(Value) == "Color3" or typeof(Value) == "UDim2"
    end, function(Index, Value)
        local Color = typeof(Value) == "Color3"
        local Position = typeof(Value) == "UDim2"
        if (Color) then
            local H, S, V = ToHSV(Value)
            return { HSVColor = { H = H, S = S, V = V } }
        end
        if (Position) then
            return { Position = {
                X = { Scale = Value.X.Scale, Offset = Value.X.Offset },
                Y = { Scale = Value.Y.Scale, Offset = Value.Y.Offset }
            } }
        end
    end)
    return EncodedConfig
end

local function loadSettings()
    local ok, data = pcall(function() return readfile(M.configFile) end)
    if ok and data then
        local ok2, parsed = pcall(function() return HttpService:JSONDecode(data) end)
        if ok2 and parsed then
            local decoded = DecodeConfig(parsed)
            if decoded.Version == DefaultSettings.Version then
                M.settings = decoded
                return
            end
        end
    end
    -- fallback: write default and use it
    M.settings = DefaultSettings
    pcall(function()
        writefile(M.configFile, HttpService:JSONEncode(EncodeConfig(DefaultSettings)))
    end)
end

local function saveSettings()
    if not M.settings then return end
    pcall(function()
        writefile(M.configFile, HttpService:JSONEncode(EncodeConfig(M.settings)))
    end)
end

-- Drawing helpers
local function newText()
    local txt = Drawing.new("Text")
    txt.Color = M.settings.Esp.Color
    txt.OutlineColor = M.settings.Esp.OutlineColor or Color3.new(0,0,0)
    txt.Size = M.settings.Esp.Size
    txt.Transparency = M.settings.Esp.Transparency
    txt.Center = true
    txt.Outline = true
    txt.Visible = false
    return txt
end

local function newLine()
    local ln = Drawing.new("Line")
    ln.Color = M.settings.Esp.Color
    ln.From = Vector2.new(0,0)
    ln.To = Vector2.new(0,0)
    ln.Thickness = M.settings.Esp.TracerThickness
    ln.Transparency = M.settings.Esp.TracerTrancparency
    ln.Visible = false
    return ln
end

local function newBox()
    local box = Drawing.new("Quad")
    box.Thickness = M.settings.Esp.Thickness
    box.Transparency = M.settings.Esp.Transparency
    box.Filled = false
    box.Color = M.settings.Esp.Color
    box.Visible = false
    return box
end

-- Create/Destroy per-player drawings
local function createDrawingsForPlayer(player)
    if M.drawings[player] then return end
    local t = {
        Text = newText(),
        Tracer = newLine(),
        Box = newBox()
    }
    M.drawings[player] = t
end

local function destroyDrawingsForPlayer(player)
    local d = M.drawings[player]
    if not d then return end
    pcall(function() if d.Text then d.Text:Remove() end end)
    pcall(function() if d.Tracer then d.Tracer:Remove() end end)
    pcall(function() if d.Box then d.Box:Remove() end end)
    M.drawings[player] = nil
end

-- Player / Character handling
local function handlePlayer(player)
    -- connect character added/removed
    M.characters[player] = player.Character
    player.CharacterAdded:Connect(function(char)
        M.characters[player] = char
    end)
    player.CharacterRemoving:Connect(function()
        M.characters[player] = nil
        local pd = M.drawings[player]
        if pd then
            pd.Text.Visible = false
            pd.Tracer.Visible = false
            pd.Box.Visible = false
        end
    end)
    if player ~= LocalPlayer then
        createDrawingsForPlayer(player)
    end
end

local function cleanupAllPlayers()
    for _, p in ipairs(Players:GetPlayers()) do
        destroyDrawingsForPlayer(p)
    end
    M.drawings = {}
    M.characters = {}
end

-- Core render/update function (mirrors original behavior)
local CurrentCamera = Workspace.CurrentCamera
local function worldToViewport(pt)
    if not CurrentCamera then CurrentCamera = Workspace.CurrentCamera end
    return CurrentCamera:WorldToViewportPoint(pt)
end

local function getTeam(player)
    return player.Team
end

local function inRenderDistance(pos, localRoot, maxDist)
    if not localRoot then return true end
    local dist = (pos - localRoot.Position).Magnitude
    return dist <= maxDist
end

local function updateFrame()
    if not M.enabled then return end
    local inset = M.uiInsetY
    local LocalRoot = M.characters[LocalPlayer] and M.characters[LocalPlayer]:FindFirstChild("HumanoidRootPart")
    for player, char in pairs(M.characters) do
        if player == LocalPlayer then
            -- skip local player visuals
            local pd = M.drawings[player]
            if pd then
                pd.Text.Visible = false
                pd.Tracer.Visible = false
                pd.Box.Visible = false
            end
            continue
        end
        local pd = M.drawings[player]
        if not pd then
            createDrawingsForPlayer(player)
            pd = M.drawings[player]
        end
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if not root then
            pd.Text.Visible = false
            pd.Tracer.Visible = false
            pd.Box.Visible = false
            continue
        end

        local aimPart = char:FindFirstChild(M.settings.Esp.TracerTo) or root
        local worldPos = aimPart.Position
        local tuple, onScreen = worldToViewport(worldPos)
        local screenPos = Vector2.new(tuple.X, tuple.Y)
        local dist = LocalRoot and (worldPos - LocalRoot.Position).Magnitude or math.huge

        local inDistance = dist <= (M.settings.Esp.RenderDistance or 9e9)
        local team = getTeam(player)
        local blacklisted = false
        for _, t in ipairs(M.settings.Esp.BlacklistedTeams or {}) do
            if t == team then blacklisted = true break end
        end

        if inDistance and onScreen and not blacklisted then
            -- text
            local nameText = ""
            if M.settings.Esp.NamesEnabled then
                nameText = nameText .. player.Name
            end
            if M.settings.Esp.DistanceEnabled then
                nameText = nameText .. (M.settings.Esp.NamesEnabled and "\n" or "") .. "[" .. math.floor(dist) .. "]"
            end
            if M.settings.Esp.HealthEnabled then
                local humanoid = char:FindFirstChildOfClass("Humanoid")
                if humanoid then
                    nameText = nameText .. " [" .. math.floor(humanoid.Health) .. "/" .. math.floor(humanoid.MaxHealth or 0) .. "]"
                end
            end
            pd.Text.Text = nameText
            pd.Text.Position = Vector2.new(screenPos.X, screenPos.Y - 40 - inset)
            pd.Text.Size = M.settings.Esp.Size
            pd.Text.Transparency = M.settings.Esp.Transparency
            pd.Text.OutlineColor = M.settings.Esp.OutlineColor or Color3.new(0,0,0)

            -- tracer
            pd.Tracer.Thickness = M.settings.Esp.TracerThickness
            pd.Tracer.Transparency = M.settings.Esp.TracerTrancparency
            pd.Tracer.From = Vector2.new(CurrentCamera.ViewportSize.X / 2, CurrentCamera.ViewportSize.Y)
            pd.Tracer.To = Vector2.new(screenPos.X, screenPos.Y)

            -- box (approx using parts bounds)
            if M.settings.Esp.BoxEsp then
                local parts = {}
                for _, part in ipairs(char:GetChildren()) do
                    if part:IsA("BasePart") then
                        local vp = worldToViewport(part.Position)
                        parts[part] = Vector2.new(vp.X, vp.Y)
                    end
                end
                -- pick extremes
                local top, bottom, left, right
                local closest, distTemp = nil, math.huge
                for _, pos in pairs(parts) do
                    local mag = (pos - Vector2.new(screenPos.X, 0)).Magnitude
                    if mag <= distTemp then closest, distTemp = pos, mag end
                end
                top = closest
                closest, distTemp = nil, math.huge
                for _, pos in pairs(parts) do
                    local mag = (pos - Vector2.new(screenPos.X, CurrentCamera.ViewportSize.Y)).Magnitude
                    if mag <= distTemp then closest, distTemp = pos, mag end
                end
                bottom = closest
                closest, distTemp = nil, math.huge
                for _, pos in pairs(parts) do
                    local mag = (pos - Vector2.new(0, screenPos.Y)).Magnitude
                    if mag <= distTemp then closest, distTemp = pos, mag end
                end
                left = closest
                closest, distTemp = nil, math.huge
                for _, pos in pairs(parts) do
                    local mag = (pos - Vector2.new(CurrentCamera.ViewportSize.X, screenPos.Y)).Magnitude
                    if mag <= distTemp then closest, distTemp = pos, mag end
                end
                right = closest
                if top and bottom and left and right then
                    pd.Box.PointA = Vector2.new(right.X, top.Y)
                    pd.Box.PointB = Vector2.new(left.X, top.Y)
                    pd.Box.PointC = Vector2.new(left.X, bottom.Y)
                    pd.Box.PointD = Vector2.new(right.X, bottom.Y)
                    pd.Box.Thickness = M.settings.Esp.Thickness
                    pd.Box.Transparency = M.settings.Esp.Transparency
                else
                    pd.Box.Visible = false
                end
            end

            -- team colors
            if M.settings.Esp.TeamColors and team then
                local teamColor = team.TeamColor.Color
                pd.Text.Color = teamColor
                pd.Box.Color = teamColor
                pd.Tracer.Color = teamColor
            else
                pd.Text.Color = M.settings.Esp.Color
                pd.Box.Color = M.settings.Esp.Color
                pd.Tracer.Color = M.settings.Esp.Color
            end

            pd.Text.Visible = true
            pd.Tracer.Visible = M.settings.Esp.TracersEnabled
            pd.Box.Visible = M.settings.Esp.BoxEsp
        else
            pd.Text.Visible = false
            pd.Tracer.Visible = false
            pd.Box.Visible = false
        end
    end
end

-- Public API
function M.Init()
    if M.initialized then return end
    M.initialized = true

    -- load settings
    loadSettings()

    -- prepare players
    for _, p in ipairs(Players:GetPlayers()) do
        handlePlayer(p)
    end
    Players.PlayerAdded:Connect(function(p) handlePlayer(p) end)
    Players.PlayerRemoving:Connect(function(p)
        M.characters[p] = nil
        local pd = M.drawings[p]
        if pd then
            pd.Text.Visible = false
            pd.Tracer.Visible = false
            pd.Box.Visible = false
            destroyDrawingsForPlayer(p)
        end
    end)

    -- render loop (always running but only updates when enabled)
    M.renderConn = RunService.RenderStepped:Connect(function()
        updateFrame()
    end)

    -- periodic save loop (every 5 seconds)
    M.saveLoop = task.spawn(function()
        while true do
            task.wait(5)
            saveSettings()
        end
    end)
end

function M.Enable()
    if not M.initialized then M.Init() end
    if M.enabled then return end
    M.enabled = true
    -- ensure drawings exist for all players
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then createDrawingsForPlayer(p) end
    end
end

function M.Disable()
    if not M.enabled then return end
    M.enabled = false
    -- hide but keep drawings (so re-enable is fast)
    for p, d in pairs(M.drawings) do
        if d.Text then d.Text.Visible = false end
        if d.Tracer then d.Tracer.Visible = false end
        if d.Box then d.Box.Visible = false end
    end
end

function M.Toggle(state)
    if state == nil then
        if M.enabled then M.Disable() else M.Enable() end
    elseif state then
        M.Enable()
    else
        M.Disable()
    end
end

function M.IsEnabled()
    return M.enabled
end

function M.GetSettings()
    return M.settings
end

function M.SetSettings(newSettings)
    if type(newSettings) ~= "table" then return end
    -- shallow merge
    for k, v in pairs(newSettings) do
        M.settings[k] = v
    end
    -- apply color/size related changes to existing drawings
    for _, d in pairs(M.drawings) do
        pcall(function()
            if d.Text then
                d.Text.Size = M.settings.Esp.Size
                d.Text.Transparency = M.settings.Esp.Transparency
                d.Text.OutlineColor = M.settings.Esp.OutlineColor
            end
            if d.Tracer then
                d.Tracer.Thickness = M.settings.Esp.TracerThickness
                d.Tracer.Transparency = M.settings.Esp.TracerTrancparency
            end
            if d.Box then
                d.Box.Thickness = M.settings.Esp.Thickness
                d.Box.Transparency = M.settings.Esp.Transparency
            end
        end)
    end
end

function M.Cleanup()
    M.Disable()
    if M.renderConn then
        pcall(function() M.renderConn:Disconnect() end)
        M.renderConn = nil
    end
    if M.saveLoop then
        -- saveLoop is an autonomous task; we won't forcibly close it but save once
        saveSettings()
        M.saveLoop = nil
    end
    for p, _ in pairs(M.drawings) do
        destroyDrawingsForPlayer(p)
    end
    M.drawings = {}
    M.characters = {}
    M.initialized = false
    M.enabled = false
end

-- auto-init but don't enable visuals until user calls Enable
pcall(function() M.Init() end)

return M
