local NoCollide = {}

local NC_CHECK_INTERVAL = 0.12
local nc_running = false
local nc_connections = {}
local nc_accumulator = 0
local nc_originalCollide = {}

local function nc_applyNoCollide(model, state)
    if not model then return end
    for _, obj in ipairs(model:GetDescendants()) do
        if obj:IsA("BasePart") then
            if state.originalCollide[obj] == nil then
                state.originalCollide[obj] = obj.CanCollide
            end
            pcall(function() obj.CanCollide = false end)
        end
    end
end

local function nc_bindModel(model)
    if not model then return end
    local state = nc_originalCollide[model]
    if not state then
        state = { originalCollide = {}, conn = nil }
        nc_originalCollide[model] = state
    end

    nc_applyNoCollide(model, state)

    if not state.conn then
        state.conn = model.DescendantAdded:Connect(function(desc)
            if desc and desc:IsA("BasePart") then
                if state.originalCollide[desc] == nil then
                    state.originalCollide[desc] = desc.CanCollide
                end
                pcall(function() desc.CanCollide = false end)
            end
        end)
        table.insert(nc_connections, state.conn)
    end
end

local function nc_bindPlayer(player)
    if player == localPlayer then return end
    table.insert(nc_connections, player.CharacterAdded:Connect(function(char)
        if char then task.defer(function() nc_bindModel(char) end) end
    end))
    if player.Character then nc_bindModel(player.Character) end
end

function NoCollide.start(interval)
    if nc_running then return end
    nc_running = true
    NC_CHECK_INTERVAL = interval or NC_CHECK_INTERVAL

    for _, player in ipairs(Players:GetPlayers()) do nc_bindPlayer(player) end
    table.insert(nc_connections, Players.PlayerAdded:Connect(nc_bindPlayer))

    table.insert(nc_connections, RunService.Heartbeat:Connect(function(dt)
        nc_accumulator = nc_accumulator + dt
        if nc_accumulator < NC_CHECK_INTERVAL then return end
        nc_accumulator = 0
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= localPlayer and player.Character then
                for _, obj in ipairs(player.Character:GetDescendants()) do
                    if obj:IsA("BasePart") and obj.CanCollide ~= false then
                        pcall(function() obj.CanCollide = false end)
                    end
                end
            end
        end
    end))
end

function NoCollide.stop()
    if not nc_running then return end
    nc_running = false

    for _, c in ipairs(nc_connections) do
        pcall(function() c:Disconnect() end)
    end
    nc_connections = {}
    nc_accumulator = 0

    for model, state in pairs(nc_originalCollide) do
        for part, orig in pairs(state.originalCollide or {}) do
            if part and part.Parent then
                pcall(function() part.CanCollide = orig end)
            end
        end
    end
    nc_originalCollide = {}
end

function NoCollide.isRunning() return nc_running end

M.NoCollide = NoCollide
