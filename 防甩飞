-- Module: LocalNoCollide
-- 只对本地玩家生效：持续把本地玩家角色的 BasePart.CanCollide 设为 false
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")

local localPlayer = Players.LocalPlayer

local M = {
    enabled = false,
    conn = nil,
    interval = 0.12, -- 检查间隔（秒）
}

local function applyNoCollideToCharacter(char)
    if not char then return end
    for _, obj in ipairs(char:GetDescendants()) do
        if obj:IsA("BasePart") then
            pcall(function() obj.CanCollide = false end)
        end
    end
end

local function onDescendantAdded(desc)
    if desc and desc:IsA("BasePart") then
        pcall(function() desc.CanCollide = false end)
    end
end

local function bindCharacter(char)
    if not char then return end
    applyNoCollideToCharacter(char)
    -- 监听新增部件
    char.DescendantAdded:Connect(onDescendantAdded)
end

function M.Init()
    -- 可选：立即绑定当前角色（不启用时不持续执行）
    if localPlayer and localPlayer.Character then
        bindCharacter(localPlayer.Character)
    end
    -- 当角色重生时再绑定（保持被动）
    if not M.charConn then
        M.charConn = localPlayer.CharacterAdded:Connect(function(char)
            bindCharacter(char)
        end)
    end
end

function M.Enable()
    if M.enabled then return end
    M.enabled = true
    if not M.conn then
        local accumulator = 0
        M.conn = RunService.Heartbeat:Connect(function(dt)
            accumulator = accumulator + dt
            if accumulator < M.interval then return end
            accumulator = 0
            local char = localPlayer and localPlayer.Character
            if char then
                applyNoCollideToCharacter(char)
            end
        end)
    end
end

function M.Disable()
    if not M.enabled then return end
    M.enabled = false
    if M.conn then
        pcall(function() M.conn:Disconnect() end)
        M.conn = nil
    end
    -- 注意：Disable 不会恢复原来 CanCollide 值（因恢复需要记录每个部件的原始值）
end

function M.Toggle(state)
    if state == nil then
        if M.enabled then M.Disable() else M.Enable() end
    elseif state then
        M.Enable()
    else
        M.Disable()
    end
end

function M.IsEnabled()
    return M.enabled
end

-- 自动初始化
pcall(function() M.Init() end)

return M
