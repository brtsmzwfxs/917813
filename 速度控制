local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local M = {
    enabled = false,
    conns = {},
    charConn = nil,
    removingConn = nil,
    enforceConnection = nil,
    humanoid = nil,
    originalWalkSpeed = 16,
    currentSpeed = 16,
}

local player = Players.LocalPlayer
if not player then
    return {
        Init = function() end,
        Enable = function() end,
        Disable = function() end,
        Toggle = function() end,
        SetSpeed = function() end,
        IsEnabled = function() return false end,
    }
end

local function safeDisconnect(c)
    if c and typeof(c) == "RBXScriptConnection" then
        pcall(function() c:Disconnect() end)
    end
end

local function applySpeed()
    if M.humanoid and M.enabled then
        pcall(function() M.humanoid.WalkSpeed = M.currentSpeed end)
    end
end

local function restoreSpeed()
    if M.humanoid then
        pcall(function() M.humanoid.WalkSpeed = M.originalWalkSpeed or 16 end)
    end
end

local function startEnforce()
    if M.enforceConnection then safeDisconnect(M.enforceConnection) end
    M.enforceConnection = RunService.RenderStepped:Connect(function()
        if M.enabled and M.humanoid then
            if M.humanoid.WalkSpeed ~= M.currentSpeed then
                pcall(function() M.humanoid.WalkSpeed = M.currentSpeed end)
            end
        end
    end)
    table.insert(M.conns, M.enforceConnection)
end

local function stopEnforce()
    safeDisconnect(M.enforceConnection)
    M.enforceConnection = nil
end

-- No UI: keep stub for compatibility with callers
local function setToggleVisual(enabled)
    -- no-op (UI removed)
end

local function onCharacterAdded(char)
    stopEnforce()
    M.humanoid = nil
    local ok, hum = pcall(function() return char:WaitForChild("Humanoid", 5) end)
    if ok and hum then
        M.humanoid = hum
        M.originalWalkSpeed = hum.WalkSpeed or M.originalWalkSpeed
        if M.enabled then
            applySpeed()
            startEnforce()
        end
    end
end

local function onCharacterRemoving()
    stopEnforce()
    if M.humanoid then
        pcall(function()
            if M.humanoid.Parent then
                M.humanoid.WalkSpeed = M.originalWalkSpeed
            end
        end)
    end
    M.humanoid = nil
end

function M.Init()
    if M.charConn then return end
    M.charConn = player.CharacterAdded:Connect(onCharacterAdded)
    M.removingConn = player.CharacterRemoving:Connect(onCharacterRemoving)
    table.insert(M.conns, M.charConn)
    table.insert(M.conns, M.removingConn)
    if player.Character then
        task.spawn(function() onCharacterAdded(player.Character) end)
    end
end

function M.Enable()
    if M.enabled then return end
    M.enabled = true
    M.currentSpeed = tonumber(M.currentSpeed) or M.currentSpeed
    setToggleVisual(true)
    if not M.humanoid and player.Character then onCharacterAdded(player.Character) end
    applySpeed()
    startEnforce()
end

function M.Disable()
    if not M.enabled then return end
    M.enabled = false
    setToggleVisual(false)
    stopEnforce()
    restoreSpeed()
end

function M.Toggle(state)
    if state == nil then
        if M.enabled then M.Disable() else M.Enable() end
    elseif state then
        M.Enable()
    else
        M.Disable()
    end
end

function M.SetSpeed(n)
    n = tonumber(n)
    if not n or n <= 0 then return end
    M.currentSpeed = n
    if M.enabled then
        applySpeed()
    end
end

function M.IsEnabled()
    return M.enabled
end

pcall(function() M.Init() end)

return M
